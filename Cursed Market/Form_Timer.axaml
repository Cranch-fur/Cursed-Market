<ui:Form xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="using:Cursed_Market.UI"
         x:Class="Cursed_Market.Form_Timer"
         Title="Timer"
         Icon="/Resources/Icon_Other.ico"
         Width="60" Height="35"
         MinWidth="60" MinHeight="35"
         MaxWidth="60" MaxHeight="35"
         Opacity="0"
         SystemDecorations="None"
         ExtendClientAreaToDecorationsHint="False"
         TransparencyLevelHint="Transparent"
         Background="Transparent"
         ShowInTaskbar="False"
         ShowActivated="False"
         Topmost="True"
         WindowStartupLocation="Manual"
         Load="Form_Timer_Load"
         FormClosing="Form_Timer_FormClosing">

  <TextBlock x:Name="label_Timer"
             Width="60" Height="35"
             Padding="0,2,0,0"
             Background="DarkSlateGray"
             Foreground="White"
             FontSize="24"
             TextAlignment="Center"
             Text="60" />
</ui:Form>