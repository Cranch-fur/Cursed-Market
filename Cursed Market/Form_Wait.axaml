<ui:Form xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="using:Cursed_Market.UI"
         x:Class="Cursed_Market.Form_Wait"
         Title="Startup"
         Icon="/Resources/Icon_Other.ico"
         Width="300" Height="60"
         MinWidth="300" MinHeight="60"
         MaxWidth="300" MaxHeight="60"
         ShowInTaskbar="False"
         ShowActivated="False"
         Topmost="True"
         WindowStartupLocation="CenterScreen"
         Load="Form_Startup_Load"
         FormClosing="Form_Wait_FormClosing">

  <TextBlock x:Name="label_Wait"
             FontSize="13"
             Text="Please wait..."
             TextAlignment="Center"
             HorizontalAlignment="Center"
             VerticalAlignment="Center" />

</ui:Form>